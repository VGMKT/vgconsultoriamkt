---
import '../index.css';

interface Props {
  title: string;
  description: string;
  path: string;
  schema?: Record<string, unknown>;
  indexable?: boolean;
}

const { title, description, path, schema, indexable = true } = Astro.props;
const fullTitle = `${title} | VG Marketing`;
const canonicalPath = path === '/' ? '/' : `${path.replace(/\/+$/, '')}/`;
const canonical = `https://vgconsultoriamkt.com.br${canonicalPath}`;
const socialImage = 'https://vgconsultoriamkt.com.br/og-image.png';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://vgconsultoriamkt.com.br/#organization',
      name: 'VG Consultoria em Marketing',
      url: 'https://vgconsultoriamkt.com.br/',
      logo: socialImage,
      image: socialImage,
      description: 'Consultoria de marketing em Fortaleza para empresas que buscam clareza, estratégia e crescimento.',
      areaServed: [
        { '@type': 'City', name: 'Fortaleza' },
        { '@type': 'AdministrativeArea', name: 'Ceará' },
        { '@type': 'Country', name: 'Brasil' },
      ],
      sameAs: [
        'https://www.instagram.com/vgconsultoriamkt/',
        'https://www.linkedin.com/company/vg-consultoria-em-marketing/',
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        email: 'atendimento@vgconsultoriamkt.com.br',
        availableLanguage: ['pt-BR'],
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://vgconsultoriamkt.com.br/#website',
      url: 'https://vgconsultoriamkt.com.br/',
      name: 'VG Consultoria em Marketing',
      publisher: { '@id': 'https://vgconsultoriamkt.com.br/#organization' },
      inLanguage: 'pt-BR',
    },
    ...(schema ? [schema] : []),
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="VG Consultoria em Marketing" />
    <meta name="theme-color" content="#202f4d" />
    {indexable ? <meta name="robots" content="index,follow" /> : <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="VG Consultoria em Marketing" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:alt" content="Logo da VG Consultoria em Marketing" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Logo da VG Consultoria em Marketing" />
    {indexable && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-TNHXZJHV');
    </script>
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TNHXZJHV" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <slot />
  </body>
</html>